{
  "name": "resumeai-pro",
  "private": true,
  "scripts": {
    "postinstall": "npm install --prefix backend && npm install --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm start --prefix frontend",
    "start": "concurrently -n backend,frontend -c blue,green \"npm:backend\" \"npm:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
