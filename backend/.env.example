# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:4200

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resumeai_pro?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_too_another_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# AI Provider - choose "openai" or "gemini"
AI_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# File upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# Email (Nodemailer - optional, for report delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ResumeAI Pro <no-reply@resumeaipro.com>"

# Admin seed (used by npm run seed:admin)
ADMIN_EMAIL=admin@resumeaipro.com
ADMIN_PASSWORD=Admin@12345
