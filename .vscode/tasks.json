		{
			"label": "Start ResumeAI backend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"backend",
				"start"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Start ResumeAI (both)",
			"dependsOn": [
				"Start ResumeAI backend",
				"Start ResumeAI frontend"
